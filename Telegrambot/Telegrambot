        public static void LoadSticker() 
        
        {
        

            if (File.Exists(jsonPath))
            {  // kardum e (jsonPath) ic amboxj text@
                string jsonString = File.ReadAllText(jsonPath);
                StickDict = JsonSerializer.Deserialize<Dictionary<string, string>>(jsonString);
                Console.WriteLine("{0} stickers  were added", StickDict.Count);

            }
            else
            {   //
                StickDict = new Dictionary<string, string>();
                Console.WriteLine("sticker.json file is not foud ");

            }
                
        }
       
